{
  "name": "wycli",
  "version": "1.0.0",
  "description": "a cli tool to developping easily",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts",
    "start": "node dist/index.js",
    "build:start": "npm run build && npm run start",
    "build:watch": "tsup --watch",
    "lint": "npx eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "debug": "node dist/index.js ls -tree"
  },
  "bin": {
    "wycli": "./dist/index.js",
    "wy": "./dist/index.js"
  },
  "keywords": [
    "cli",
    "typescript"
  ],
  "author": "Wy",
  "license": "MIT",
  "devDependencies": {
    "@types/figlet": "^1.5.6",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "tsup": "^8.5.1",
    "typescript": "^5.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "tree-node-cli": "^1.6.0"
  }
}